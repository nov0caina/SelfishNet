<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SelfishNet.MainWindow"
        Title="SelfishNet by Nov0caina" Width="800" Height="500"
        Background="#1e1e1e">

    <Grid RowDefinitions="Auto, *, Auto" Margin="10">
    
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
            <TextBlock Text="Interfaz:" VerticalAlignment="Center" Foreground="White"/>
            <ComboBox Name="NetInterfacesBox" Width="200"/>
            <Button Name="BtnScan" Content="🔍 Escanear Red" Click="OnScanClick" Background="#007ACC" Foreground="White"/>
            <Button Name="BtnSpoof" Content="⚡ START ARP SPOOF" Click="OnSpoofClick" Background="#CA3E47" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#444" BorderThickness="1" Background="#252526">
            <Grid RowDefinitions="Auto, *">
            
                <Grid Grid.Row="0" ColumnDefinitions="1.2*, 1.5*, 2*, 1.5*, 0.6*, 0.6*" Background="#333" Height="30">
                    <TextBlock Text="IP Address" Grid.Column="0" VerticalAlignment="Center" Margin="10,0" Foreground="#AAA" FontWeight="Bold"/>
                    <TextBlock Text="MAC Address" Grid.Column="1" VerticalAlignment="Center" Margin="10,0" Foreground="#AAA" FontWeight="Bold"/>
                    <TextBlock Text="Device" Grid.Column="2" VerticalAlignment="Center" Margin="10,0" Foreground="#AAA" FontWeight="Bold"/>
                    <TextBlock Text="Traffic" Grid.Column="3" VerticalAlignment="Center" Margin="10,0" Foreground="#AAA" FontWeight="Bold"
                               ToolTip.Tip="Traffic monitoring requires ARP Spoof active with Redirect ✓"/>
                    <TextBlock Text="Spoof" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#AAA" FontWeight="Bold"/>
                    <TextBlock Text="Block" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#AAA" FontWeight="Bold"/>
                </Grid>

                <ListBox Grid.Row="1" Name="PcListBox" Background="Transparent">
                    <ListBox.ItemTemplate>
                    <DataTemplate>
                            <Grid ColumnDefinitions="1.2*, 1.5*, 2*, 1.5*, 0.6*, 0.6*">
                                <TextBlock Grid.Column="0" Text="{Binding IpDisplay}" VerticalAlignment="Center" Foreground="White"/>
                        
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                    <TextBlock Text="{Binding MacDisplay}" VerticalAlignment="Center" Foreground="#DDD"/>
                                    <TextBlock Text="(Router)" IsVisible="{Binding IsGateway}" Foreground="Yellow" VerticalAlignment="Center"/>
                                    <TextBlock Text="(You)" IsVisible="{Binding IsLocalPc}" Foreground="Cyan" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding DeviceLabel}" VerticalAlignment="Center" Foreground="#4FC3F7" FontSize="12"/>

                                <TextBlock Grid.Column="3" Text="{Binding DownloadSpeed}" VerticalAlignment="Center" Foreground="#81C784" FontSize="11"/>

                                <CheckBox Grid.Column="4" IsChecked="{Binding Redirect}" IsEnabled="{Binding CanControl}" HorizontalAlignment="Center"/>
                        
                                <CheckBox Grid.Column="5" IsChecked="{Binding Block}" IsEnabled="{Binding CanControl}" HorizontalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="Ready." Name="StatusText" Foreground="Gray" Margin="0,5,0,0"/>
    </Grid>
</Window>